      .catch(e=>{ _bad[k]=f+' ('+(e&&e.message||'decode failed')+')'; _sndPill(); }); }); }
function _sndRevSeen(rev){ if(!rev||rev===_sndRev) return; _sndRev=rev; if(_ctx) _loadSounds(rev); }   // files changed -> re-decode
