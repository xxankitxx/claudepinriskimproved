['pointerdown','keydown','touchstart'].forEach(evn=>document.addEventListener(evn,()=>{ _lockedAtDown=_locked(); _unlock(); },true));
_audioCtx();
// keep trying: a Chrome window started with --autoplay-policy=no-user-gesture-required resumes at once
setInterval(()=>{ const c=_audioCtx(); if(c&&c.state==='suspended') c.resume().catch(()=>{}); _isLeader=_leader(); _flushLocked(); _sndPill(); }, 2000);
})();
// play every engine sound event exactly once (seq cursor), judged on the BROWSER clock (server offset).
// Trade cues are kept for 120 s (if a whole trade is late, only its exit plays); approach / feed / armed
// expire after 20 s. On first load the last 15 s are played, older history is not.
function consumeSounds(s){
  if(s.server_ms) _clkOff=Date.now()-s.server_ms;
  if(s.sounds_rev) _sndRevSeen(s.sounds_rev);
  if(s.snd_fallback) _fbSeqs=new Set(s.snd_fallback);
  if(s.boot_id!==undefined && _sndBoot!==null && s.boot_id!==_sndBoot) _sndSeq=0;
  if(s.boot_id!==undefined) _sndBoot=s.boot_id;
  const ev=s.sound_events||[]; if(!ev.length){ if(_sndSeq===null) _sndSeq=0; return; }
  const maxSeq=ev[ev.length-1].seq, nowSrv=Date.now()-_clkOff;
  if(_sndSeq===null){ const rec=ev.filter(e=>nowSrv-e.ts<=15000);      // first load: only the newest cue of
    _sndSeq=rec.length?rec[rec.length-1].seq-1:maxSeq; }                 // the last 15 s, never a burst
  if(maxSeq<_sndSeq) _sndSeq=0;
  let fresh=ev.filter(e=>e.seq>_sndSeq).map(e=>{ let k=e.kind; if(k==='approach') k=(/upper/i.test(e.text||'')?'approach_UP':'approach_DOWN');
    return {k,seq:e.seq,age:nowSrv-e.ts,text:e.text}; });
  const li=fresh.map(x=>x.k.startsWith('exit')).lastIndexOf(true);
  fresh.forEach((x,i)=>{
    _lastSndText=new Date(Date.now()-x.age).toLocaleTimeString()+' '+x.k+' — '+(x.text||'');
    const lim=TRADE_KINDS[x.k]?120000:20000;
    if(x.age>lim){ _outcome(x.k,x.seq,'stale'); return; }
    if(x.k==='entry' && i<li && x.age>20000){ _outcome(x.k,x.seq,'stale'); return; }
    playKind(x.k,x.seq); });
  _sndSeq=maxSeq; _sndPill(); }

// ---- FEED WATCHDOG — a dead engine or stalled feed must be UNMISSABLE, never a frozen-but-green screen ----
let _wdLastOk=0,_wdLastRts=null,_wdLastRtsChange=0;
let _closeHM=15*60+40;   // 2.0.4: F&O close from the engine (regime.closing.session_close); 15:40 under CAS
const _hmOf=t=>{const x=String(t||'').split(':');return x.length>=2?(+x[0])*60+(+x[1]):null;};
const todHM=ms=>{const d=new Date(ms);return d.getHours()*60+d.getMinutes();};
function marketPhase(){const d=new Date();const hm=d.getHours()*60+d.getMinutes();
  if(hm<9*60+20)return 'preopen'; if(hm>=_closeHM)return 'closed'; return 'open';}
function applyWatchdog(fetchFailed){
  // Judged by SERVER round-time, not the wall clock — an evening tape REPLAY has round_ts advancing
  // and must render normally, never masked by a false SESSION CLOSED.
  const al=document.getElementById('alert'),icon=document.getElementById('alerticon'),
        txt=document.getElementById('alerttxt'),rd=document.getElementById('alertrd');
  const now=Date.now();
  const noFetch=fetchFailed||(_wdLastOk>0&&now-_wdLastOk>5000);
  const stalled=(!noFetch&&_wdLastRtsChange>0&&(now-_wdLastRtsChange>5000));
  if(!noFetch&&!stalled){ document.body.classList.remove('frozen'); return false; }
  // data has stopped — decide CLOSED (expected, calm) vs FROZEN (a real problem, loud)
  const endOfDay=_wdLastRts!=null&&todHM(_wdLastRts)>=_closeHM-1;   // last round reached the F&O close
  if(endOfDay){
    document.body.classList.remove('frozen');
    al.className='alert a-closed';icon.textContent='◼';
    txt.textContent='SESSION CLOSED — last round '+hhmmss(_wdLastRts)+' · tapes closed';rd.textContent='';
    return true;
  }
  al.className='alert a-frozen';icon.textContent='🚨';
  if(noFetch){
    txt.textContent='DATA FROZEN — no response from engine · last update '+(_wdLastOk?hhmmss(_wdLastOk):'never');
    rd.textContent='check the engine terminal';
  }else{
    txt.textContent='DATA FROZEN — engine not advancing · last round '+hhmmss(_wdLastRts);
    rd.textContent='feed stalled or engine hung';
  }
  document.body.classList.add('frozen');
  return true;
}

// ===== NIFTY HERO PANEL render — call renderNiftyPanel(s.nifty, s.arming, s) every second =====
function renderNiftyPanel(n, a, s) {
  n = n || {}; a = a || {}; s = s || {};
  const f   = (x, d = 2) => x == null ? '—' : Number(x).toFixed(d);
  const cls = v => v > 0 ? 'up' : (v < 0 ? 'dn' : 'mut');
  const sgn = v => v > 0 ? '+' : '';
  const arr = d => (d == null || Math.abs(d) < 1e-9) ? '' : (d > 0 ? '▲' : '▼');
  const $   = id => document.getElementById(id);

  // spot + delta — if the NIFTY tick ITSELF is stale (feed gap), dim the 46px spot and badge it:
  // the freshness bar below measures LEVEL age, not tick age, so without this a frozen NIFTY quote
  // looks perfectly live on the most-trusted panel.
  const tickStale = !!(s.instruments && s.instruments.NIFTY && s.instruments.NIFTY.stale);
  $('nspot').textContent = f(n.spot, 2);
  $('nspot').style.opacity = tickStale ? '.45' : '';
  $('tickstale').style.display = tickStale ? '' : 'none';
  const nd = $('ndelta');
  nd.textContent = (n.delta != null ? arr(n.delta) + ' ' + sgn(n.delta) + f(n.delta) : '');
  nd.className = 'ndelta ' + cls(n.delta);

  // CE / PE @ ATM strike
  $('natmce').textContent = f(n.atm_ce);
  $('natmpe').textContent = f(n.atm_pe);
  $('natmce_k').textContent = (n.atm ?? '—');
  $('natmpe_k').textContent = (n.atm ?? '—');

  // secondary stats
  $('nfut').textContent = f(n.future);
  $('nfutlbl').textContent = (n.future_mode === 'ACTUAL' ? 'FUT · actual' : 'FUT · implied');
  const nb = $('nbasis');
  nb.textContent = (n.basis == null ? '—' : sgn(n.basis) + f(n.basis));
  nb.className = 'sv ' + cls(n.basis);
  $('nbasislbl').textContent = (n.basis == null ? 'BASIS' : (n.basis >= 0 ? 'BASIS · prem' : 'BASIS · disc'));
  $('nvix').textContent = f(n.vix);
  $('noi').textContent = (n.max_oi_ce ?? '—') + ' / ' + (n.max_oi_pe ?? '—');

  // pin level numbers on band ends
  $('nlo').textContent = f(n.lower);
  $('nup').textContent = f(n.upper);

  const du = n.dist_up, dd = n.dist_dn;
  const haveBand = (n.lower != null && n.upper != null && n.spot != null);
  const span = haveBand ? ((n.upper - n.lower) || 1) : 1;
  const card = $('niftycard');

  // spot marker position (clamped to 4%..96% so it never clips the rounded caps)
  if (haveBand) {
    const clamped = Math.max(0, Math.min(1, (n.spot - n.lower) / span));
    $('spotMarker').style.left = (4 + clamped * 92) + '%';
  }

  // danger state (priority: breach > critical(<=2) > approach(<=5) > safe)
  let state = 'safe', sideClass = '';
  const nearest = Math.min(du == null ? 1e9 : du, dd == null ? 1e9 : dd);
  if (du != null && du <= 0)      { state = 'breach-up'; sideClass = 'up'; }
  else if (dd != null && dd <= 0) { state = 'breach-dn'; sideClass = 'dn'; }
  else {
    const upNear = (du != null && du < (dd == null ? 1e9 : dd));
    sideClass = upNear ? 'up' : 'dn';
    // 2.0: thresholds follow the engine's real entry distance (1.x hard-coded 2/5 pts while the
    // engine entered at 7, so the banner said BUY while this panel still read "safe").
    const _px = ((window._lastState||{}).arming||{}).proximity_pts || 7;
    if (nearest <= _px * 0.4)  state = 'critical';
    else if (nearest <= _px)   state = 'approach';
    else                   state = 'safe';
  }

  // single danger banner (one source of truth for proximity + side)
  const banner = $('nbanner');
  let btext, bmod;
  if (state === 'breach-up')      { btext = '▲ BREACHED UPPER +' + f(Math.abs(du)); bmod = 'breach up'; }
  else if (state === 'breach-dn') { btext = '▼ BREACHED LOWER −' + f(Math.abs(dd)); bmod = 'breach dn'; }
  else if (state === 'critical')  { btext = (sideClass === 'up' ? '▲' : '▼') + ' ' + f(nearest, 1) + ' PTS — BREACH IMMINENT'; bmod = 'critical ' + sideClass; }
  else if (state === 'approach')  { btext = (sideClass === 'up' ? '▲' : '▼') + ' ' + f(nearest, 1) + ' PTS — APPROACHING ' + (sideClass === 'up' ? 'UPPER' : 'LOWER'); bmod = 'approach ' + sideClass; }
  else if (nearest >= 1e8)        { btext = 'waiting for levels'; bmod = 'safe'; }   // no band yet — never print the 1e9 sentinel
  else                            { btext = f(nearest, 1) + ' PTS TO NEAREST PIN'; bmod = 'safe'; }
  banner.textContent = btext;
  banner.className = 'nbanner ' + bmod;

  // per-end distance chips
  const chip = v => { if (v == null) return '—'; if (v <= 0) return 'BREACH'; return f(v, v < 10 ? 1 : 0) + ' pts'; };
  $('ndnd').textContent = chip(dd);
  $('nupd').textContent = chip(du);

  // band hot-side tint + breach/critical card classes
  card.classList.remove('hot-up', 'hot-dn', 'is-breach', 'is-critical');
  if (state === 'breach-up' || state === 'breach-dn') card.classList.add('is-breach');
  else if (state === 'critical') card.classList.add('is-critical');
  if (sideClass === 'up') card.classList.add('hot-up');
  else if (sideClass === 'dn') card.classList.add('hot-dn');

  // BUY target (from arming), coloured by lean
  const buy = $('nbuy'), tgt = a.target;
  if (tgt && tgt.label) {
    buy.style.display = '';
    $('nbuytxt').textContent = tgt.label;
    buy.className = 'nbuy ' + (a.lean === 'UP' ? 'up' : (a.lean === 'DOWN' ? 'dn' : ''));
  } else buy.style.display = 'none';

  // arming state pill
  const pill = $('narm');
  if (a.state) { pill.style.display = ''; pill.textContent = a.state.replace(/_/g, ' '); pill.className = 'narm s-' + a.state; }
  else pill.style.display = 'none';

  // calc provenance
  const C = n.calc, tt = ms => ms ? new Date(ms).toLocaleTimeString() : '—', ci = $('calcinfo');
  if (!C) ci.innerHTML = '<span class="mut">levels not yet calculated</span>';
  else ci.innerHTML =
    'calc <b>' + tt(C.ts) + '</b> <span class="mut">(' + (C.trigger || '') + ')</span> · ' +
    'CE <b>' + C.k_ce + '</b>@' + f(C.vwap_ce) + ' · PE <b>' + C.k_pe + '</b>@' + f(C.vwap_pe) +
    ' · <span class="dn">L ' + f(C.lower) + '</span> / <span class="up">U ' + f(C.upper) + '</span>';

  // freshness bar + re-anchor countdown
  const fbarWrap = $('freshwrap'), fbar = $('freshbar'), flbl = $('freshlbl');
  if (C && n.held_age_secs != null) {
    fbarWrap.style.display = '';
    const h = n.hold_secs || 1200, age = n.held_age_secs;
    const frac = Math.max(0, Math.min(1, age / h));
    const left = Math.max(0, h - age);
    fbar.style.width = (frac * 100) + '%';
    fbar.style.background = s.levels_stale ? 'var(--dn)' : (frac > 0.85 ? 'var(--dn)' : (frac > 0.5 ? 'var(--acc)' : 'var(--up)'));
    flbl.textContent = s.levels_stale ? 'STALE · held ' + dur(age) : 'held ' + dur(age) + ' · re-anchor in ' + dur(left);
    flbl.style.color = s.levels_stale ? 'var(--dn)' : 'var(--mut)';
  } else fbarWrap.style.display = 'none';

  // stale flag
  const stale = !!s.levels_stale;
  $('lvlstale').style.display = stale ? '' : 'none';
  card.classList.toggle('stale', stale);
}

