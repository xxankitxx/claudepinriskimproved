  let t0=buf[0]; for(const p of buf){ if(p.t>=t1.t-winMs){ t0=p; break; } }
  const dt=t1.t-t0.t; if(dt<15000) return null; return (t1.v-t0.v)/(dt/60000); }
function sparkSvg(series,w,h,opts){ // series: [{t,v}] -> polyline; opts: {floor:[{t,v}], hi:number, dots:[{t,v,c}], color}
  opts=opts||{}; const all=series.concat(opts.floor||[]);
  if(series.length<2) return '';
  const t0=all[0].t, t1=series[series.length-1].t||t0+1;
  let mn=Infinity,mx=-Infinity; all.forEach(p=>{mn=Math.min(mn,p.v);mx=Math.max(mx,p.v);});
  if(opts.hi!=null){mn=Math.min(mn,opts.hi);mx=Math.max(mx,opts.hi);}
