  const X=t=>(( (t-t0)/Math.max(1,t1-t0) )*(w-4)+2).toFixed(1);
  const Y=v=>(h-2-((v-mn)/(mx-mn))*(h-4)).toFixed(1);
  const line=pts=>pts.map(p=>X(p.t)+','+Y(p.v)).join(' ');
  let svg='<polyline fill="none" stroke="'+(opts.color||'currentColor')+'" stroke-width="1.3" points="'+line(series)+'"/>';
  if(opts.floor&&opts.floor.length>1) svg+='<polyline fill="none" stroke="var(--dn)" stroke-width="1" stroke-dasharray="3,2" points="'+line(opts.floor)+'"/>';
  if(opts.hi!=null) svg+='<line x1="2" y1="'+Y(opts.hi)+'" x2="'+(w-2)+'" y2="'+Y(opts.hi)+'" stroke="var(--mut)" stroke-width="0.8" stroke-dasharray="2,3"/>';
  (opts.dots||[]).forEach(d=>{svg+='<circle cx="'+X(d.t)+'" cy="'+Y(d.v)+'" r="2" fill="'+d.c+'"/>';});
  return svg; }
function stcls(s){return s&&s.endsWith('UP')?'up':(s&&s.endsWith('DOWN')?'dn':'mut');}
function stbadge(s){const c=s&&s.endsWith('UP')?'b-up':(s&&s.endsWith('DOWN')?'b-dn':'b-neu');return '<span class="badge '+c+'">'+s+'</span>';}

// ---- ALERT SOUNDS (VAJRA 2.0.2) — the ENGINE decides when a sound is due; this page only plays it. ----
// Cues: entry / exit_profit / exit_loss / approach (up / down) / feed_alarm / armed (09:20 sound check).
// Sister/stock breaches NEVER make a sound. Rate limits + hysteresis live in vajra/alerts.py.
// 2.0.2 (sound council + operator): ONLY real MP3 files play -- no browser tones, no Python/Windows
// sounds. Sound is ON by default and stays ON until the operator turns it OFF (and OFF stays OFF until he
// turns it ON). A locked page shows a red banner + tab title and keeps missed trade cues for the unlock;
// a higher-priority cue cuts a lower one; each cue's length decides when the next may start; files are
// re-fetched when they change (sounds_rev); a broken file shows a red banner; only one tab plays; every
// cue's outcome is reported to the engine (which warns on its console when no page can play).
const SND={entry:'entry.mp3',exit_profit:'exit_profit.mp3',exit_loss:'exit_loss.mp3',
           approach_UP:'approach_up.mp3',approach_DOWN:'approach_dn.mp3',feed_alarm:'feed_alarm.mp3',armed:'armed.mp3'};
const PRIO={exit_loss:5,exit_profit:5,entry:4,feed_alarm:3,approach_UP:2,approach_DOWN:2,armed:1,test:1};
const TRADE_KINDS={entry:1,exit_profit:1,exit_loss:1,feed_alarm:1};
function _ls(k,v){try{ if(v===undefined) return localStorage.getItem(k); localStorage.setItem(k,v);}catch(e){return null;}}
// ON by default; OFF only when the operator turns it off, and it stays off until he turns it back on.
let _sndOff=_ls('vajra_snd_off')==='1';
const _muted=()=>_sndOff;
let _ctx=null,_buf={},_bad={},_q=[],_cur=null,_sndSeq=null,_sndBoot=null,_lastSndText='',_sndRev=null,
    _clkOff=0,_pendLocked=[],_outcomes=[],_wasLocked=null,_lockedAtDown=false,_fbSeqs=new Set();
let _beaconNow=()=>{};
const _tabId=Math.random().toString(36).slice(2,10);
function _audioCtx(){
  if(_ctx && _ctx.state!=='closed') return _ctx;
  const C=window.AudioContext||window.webkitAudioContext; if(!C) return null;
  try{ _ctx=new C(); }catch(e){ _ctx=null; return null; }
